# Copiar a .env en el Droplet y completar. NUNCA subir este archivo a git ni compartirlo.
DOMINIO_APP=condominio.zentapro.com
DOMINIO_CONSOLA=consola.zentapro.com
# Claves: generar con  openssl rand -base64 36 | tr -d '/+='
POSTGRES_CLAVE=
API_CLAVE_BD=
JWT_SECRETO=
# Correo saliente (p. ej. el SMTP del dominio zentapro.com)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=ZPro Condominio <no-responder@zentapro.com>
# Opcionales
FCM_CUENTA_SERVICIO=
SECRETOS_BANCOS={}
DATOS_PAGO_ZENTAPRO=
