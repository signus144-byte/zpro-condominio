# Servidor ZPro Condominio · variables de entorno (copiar a .env para correr sin Docker)
NODE_ENV=development
PUERTO=3000
DATABASE_URL=postgres://zpro_api:zpro_api_local@localhost:5432/zpro
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/zpro
# En producción: 64+ caracteres aleatorios (openssl rand -base64 48)
JWT_SECRETO=desarrollo-local-cambiar-en-produccion-0123456789abcdef
ARCHIVOS_DIR=./datos/archivos
URL_PUBLICA=http://localhost:3000
URL_APP=http://localhost:8080
CORS_ORIGENES=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost
SMTP_HOST=localhost
SMTP_PUERTO=1025
CORREO_REMITENTE=ZPro Condominio <no-responder@zentapro.com>
# Opcional: notificaciones push (JSON de la cuenta de servicio de Firebase en una sola línea)
FCM_CUENTA_SERVICIO=
TAREAS_ACTIVAS=si
# Datos de demostración (condominio Los Samanes + usuarios con clave demo-1234). Solo en local.
SEMILLA_DEMO=si
